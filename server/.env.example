# ---------------------------------------------------------------------------
# LocalSchema AI - server environment
#
# Copy this file to `server/.env` and fill in the values.
# Only the variables under "Required" are needed to boot the API.
# The rest gate optional features and are validated only when that feature is on.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB connection string. Local example:
#   mongodb://127.0.0.1:27017/localschema
# Atlas example:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/localschema?retryWrites=true&w=majority
MONGODB_URI=

# Secrets. Generate unique values, never reuse across environments:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encrypts tenant-supplied secrets at rest (each workspace's own AI provider
# key). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If left blank it is derived from JWT_REFRESH_SECRET, which means rotating that
# secret makes stored provider keys unreadable (tenants must re-paste them).
# Set it explicitly in production.
ENCRYPTION_KEY=

# --- AI (schema generation) -------------------------------------------------
# NEVER put a real key in this file — it is a committed template. Put real keys
# only in server/.env (which is gitignored).
#
# These settings are the PLATFORM FALLBACK only — used by workspaces that have
# not pasted their own key in Settings. A workspace may use ANY supported
# provider regardless of AI_PROVIDER; see server/src/services/ai/providers.js.
#
# Choose the fallback provider:
#   AI_PROVIDER=openai      -> OPENAI_API_KEY / OPENAI_MODEL
#   AI_PROVIDER=gemini      -> GEMINI_API_KEY / GEMINI_MODEL
#   AI_PROVIDER=anthropic   -> ANTHROPIC_API_KEY / ANTHROPIC_MODEL
#   AI_PROVIDER=groq        -> GROQ_API_KEY / GROQ_MODEL
#   AI_PROVIDER=openrouter  -> OPENROUTER_API_KEY / OPENROUTER_MODEL
# Leave the active provider's key blank to keep AI generation disabled
# (document parsing still works without it).
AI_PROVIDER=gemini

# OpenAI: keys start with "sk-". Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini: keys start with "AIza". Create at https://aistudio.google.com/apikey
# Model must be one currently available to your key (older ones get retired).
# List yours: GET https://generativelanguage.googleapis.com/v1beta/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (Claude): keys start with "sk-ant-". Create at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Groq: keys start with "gsk_". Create at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter: keys start with "sk-or-". Create at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- AppsFields hub (multi-tenant) ------------------------------------------
# Shared secret the central hub sends on /platform/* calls (provision/suspend).
# Leave blank to run this app standalone (those endpoints stay disabled).
PLATFORM_SECRET=

# --- Seed data (section 29) -------------------------------------------------
# Used only by `npm run seed`. Never commit real credentials.
ADMIN_EMAIL=@gmail.com
ADMIN_PASSWORD=
DEMO_USER_EMAIL=@gmail.com
DEMO_USER_PASSWORD=
DEMO_AGENCY_EMAIL=@gmail.com
DEMO_AGENCY_PASSWORD=

# --- Billing (Phase 7) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Object storage (optional) ----------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Transactional email -----------------------------------------------------
# Product name used in email subjects and templates.
APP_NAME=LocalSchema AI

# 'none' disables sending. Password-reset requests still return success (so they
# cannot be used to probe for accounts) but no mail goes out; in development the
# reset link is written to the log instead.


# Resend: create a key at https://resend.com/api-keys
# EMAIL_FROM must be on a domain you have VERIFIED with Resend, or sends fail
# with a 422. Display-name form is fine: "LocalSchema AI <hi@yourdomain.com>"
